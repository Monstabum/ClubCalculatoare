<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ================================================================
       CONNECTION STRING — modifică doar această secțiune pentru a
       schimba serverul / baza de date, fără a recompila aplicația.

       Parametri:
          Data Source      — numele instanței SQL Server
                             "."  = instanța implicita locala
                             ".\SQLEXPRESS" = instanța SQL Express
          Initial Catalog  — numele bazei de date (ClubCalculatoare)
          Integrated Security = True → autentificare Windows (recomandat)

       Alternativă SQL Login (decomentează și completează):
          Data Source=.;Initial Catalog=ClubCalculatoare;
          User ID=appuser;Password=ParolaTa123!;
          TrustServerCertificate=True
   ================================================================ -->
  <connectionStrings>
    <!-- Activ: SQL Server Express (instanta locala .\SQLEXPRESS).
         Foloseste-l cand ai instalat "SQL Server Express". -->
    <add name="ClubCalculatoare" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ClubCalculatoare;Integrated Security=True;TrustServerCertificate=True" providerName="Microsoft.Data.SqlClient" />
    <!-- Alternativa: SQL Server standard / Developer (instanta implicita).
         Foloseste-o cand ai instalat "SQL Server" clasic (nu Express):
         decomenteaza linia urmatoare si comenteaza linia .\SQLEXPRESS de mai sus.
    <add name="ClubCalculatoare" connectionString="Data Source=.;Initial Catalog=ClubCalculatoare;Integrated Security=True;TrustServerCertificate=True" providerName="Microsoft.Data.SqlClient" />
    -->
  </connectionStrings>
  <!-- ================================================================
       SETĂRI APLICAȚIE — parametri configurabili fără recompilare
   ================================================================ -->
  <appSettings>
    <!-- Numărul maxim de tentative eșuate de autentificare înainte de
         a bloca contul temporar (0 = dezactivat). Blocarea este
         persistentă: se salvează în tabela Utilizatori. -->
    <add key="MaxLoginAttempts" value="5" />
    <!-- Durata blocării contului după epuizarea tentativelor (minute). -->
    <add key="LoginLockoutMinutes" value="15" />
    <!-- Expirarea sesiunii la inactivitate, în minute (0 = dezactivat).
         După acest interval fără interacțiune, aplicația revine la login. -->
    <add key="SessionTimeoutMinutes" value="15" />
    <add key="AlertPropertyDays" value="90" />
    <add key="AlertTransactionDays" value="30" />
    <add key="AlertViewingDays" value="7" />
    <!-- Calea fișierului de log. Folderele sunt create automat.
         %AppData% = C:\Users\<user>\AppData\Roaming              -->
    <add key="LogFilePath" value="%AppData%\AppClubCalculatoare\app.log" />
    <!-- SMTP pentru resetarea parolei (FormLogin.cs).
         Completeaza cu datele reale; campurile goale = SMTP nedeconfigurat
         (aplicatia afiseaza un mesaj clar in loc sa esueze silentios). -->
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="" />
    <add key="SmtpPassword" value="" />
    <add key="SmtpFrom" value="noreply@clubcalculatoare.ro" />
    <!-- MODUL_FOTO: stocarea fotografiilor echipamentelor.
         PhotosRootPath suporta variabile de mediu (%AppData%).
         Structura: PhotosRootPath\Echipamente{id:D3}\orig|thumb|medium -->
    <add key="PhotosRootPath" value="%AppData%\AppClubCalculatoare\Poze" />
    <!-- Dimensiunea maxima a unui fisier foto (MB). -->
    <add key="PhotoMaxSizeMB" value="10" />
    <!-- Latura miniaturii patrate crop-centru (px). -->
    <add key="PhotoThumbSize" value="200" />
    <!-- Latura lunga maxima a versiunii medii (px). -->
    <add key="PhotoMediumSize" value="1200" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
</configuration>
